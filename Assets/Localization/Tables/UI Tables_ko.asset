  - m_Id: 27354519822336
    m_Localized: "\uACC4\uC18D\uD558\uB824\uBA74 \uD0ED\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016640
    m_Localized: "\uD654\uC131 \uAC1C\uCC99\uC9C0\uC5D0 \uC624\uC2E0 \uAC83\uC744
      \uD658\uC601\uD569\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016641
    m_Localized: "\uB4DC\uB9B4\uB7EC\uB294 \uAD11\uC11D\uC744 \uCC44\uAD74\uD558\uACE0
      \uC7AC\uB8CC\uB97C \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4. \uC6B4\uBC18\uC778\uC740
      \uC790\uC7AC\uB97C \uC218\uAC70\uD558\uC5EC \uC815\uC720\uC18C\uB85C \uAC00\uC838\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016642
    m_Localized: "\uC774\uAC83\uC740 \uAD11\uACE0 \uBD80\uC2A4\uD2B8 \uBC84\uD2BC\uC785\uB2C8\uB2E4.
      2\uBC30\uC758 \uC774\uC775, 50%\uC758 \uC18D\uB3C4 \uC99D\uAC00, 3\uBC30\uC758
      \uBE44\uC804\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016643
    m_Localized: "\uCC28\uACE0\uC5D0\uC11C\uB294 \uC0C8\uB85C\uC6B4 \uCC28\uB7C9\uC744
      \uAD6C\uB9E4\uD558\uACE0 \uBC30\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016644
    m_Localized: "\uAD11\uC11D \uD328\uB110\uC5D0\uC11C\uB294 \uAC01 \uC7AC\uB8CC\uC758
      \uAC00\uACA9\uACFC \uC774\uC775 \uC99D\uB300\uB97C \uD655\uC778\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016645
    m_Localized: "\uADF8\uAC8C \uAE30\uBCF8\uC774\uC5D0\uC694! \uC774\uC81C \uC990\uAC70\uC6B4
      \uCC44\uAD74\uC744 \uC990\uACA8\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
