    m_Metadata:
      m_Items: []
  - m_Id: 18339004507217920
    m_Localized: "MINERA ESSES MIN\xC9RIOS PARA COME\xC7ARMOS A GANHAR DINHEIRO!"
    m_Metadata:
      m_Items: []
  - m_Id: 18339004507217921
    m_Localized: "\xD3TIMO! AGORA USE UM TRANSPORTADOR PARA VEND\xCA-LO!"
    m_Metadata:
      m_Items: []
  - m_Id: 18339004507217922
    m_Localized: "V\xC1 PEGAR OS MIN\xC9RIOS E TRAGA-OS AQUI PARA RECEBER O PAGAMENTO!"
    m_Metadata:
      m_Items: []
  - m_Id: 18442936013283328
    m_Localized: "VOC\xCA TERMINOU O TUTORIAL!"
