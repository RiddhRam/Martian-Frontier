  - m_Id: 18255652577280
    m_Localized: "CONFIGURA\xC7\xD5ES"
    m_Metadata:
      m_Items: []
  - m_Id: 27354519822336
    m_Localized: TOQUE PARA CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016640
    m_Localized: "BEM-VINDO \xC0 FRONTEIRA MARCIANA!"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016641
    m_Localized: "PERFURADORES MINERAM MIN\xC9RIOS E DEIXAM MATERIAIS. OS CAMINH\xD5ES
      PEGAM OS MATERIAIS E LEVAM PARA A REFINARIA."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016642
    m_Localized: "ESTES S\xC3O OS BOT\xD5ES DE AUMENTO DE AN\xDANCIOS. VOC\xCA PODE
      OBTER LUCROS 2X, AUMENTO DE VELOCIDADE DE 50% E VIS\xC3O 3X."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016643
    m_Localized: "A GARAGEM PERMITE COMPRAR E IMPLANTAR VE\xCDCULOS NOVOS."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016644
    m_Localized: "NO PAINEL DE MIN\xC9RIO VOC\xCA PODE VER O PRE\xC7O DE CADA MATERIAL
      E SEU AUMENTO DE LUCRO."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016645
    m_Localized: "ISSO \xC9 O B\xC1SICO! AGORA VAI SE DIVERTIR MINERANDO!"
    m_Metadata:
      m_Items: []
