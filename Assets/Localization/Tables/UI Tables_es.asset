      m_Items: []
  - m_Id: 27354524016640
    m_Localized: "\xA1BIENVENIDO A LA FRONTERA MARCIANA!"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016641
    m_Localized: "LOS PERFORADORES EXTRAEN MINERALES Y MATERIALES DE CA\xCDDA. LOS
      TRANSPORTISTAS RECOGEN LOS MATERIALES Y LOS TRAE A LA REFINER\xCDA."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016642
    m_Localized: "ESTOS SON LOS BOTONES PARA IMPULSAR ANUNCIOS. PUEDES OBTENER GANANCIAS
      2X, 50% DE AUMENTO DE VELOCIDAD Y VISI\xD3N 3X."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016643
    m_Localized: "EL GARAJE TE PERMITE COMPRAR Y UTILIZAR VEH\xCDCULOS NUEVOS."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016644
    m_Localized: EN EL PANEL DE MINERAL PUEDES VER EL PRECIO DE CADA MATERIAL Y SUS
      IMPULSORES DE GANANCIAS.
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016645
    m_Localized: "\xA1ESO ES LO B\xC1SICO! \xA1AHORA DIVI\xC9RTETE MINANDO!"
