      m_Items: []
  - m_Id: 27354524016640
    m_Localized: "\u092E\u0902\u0917\u0932 \u0917\u094D\u0930\u0939 \u0915\u0940
      \u0938\u0940\u092E\u093E \u092A\u0930 \u0906\u092A\u0915\u093E \u0938\u094D\u0935\u093E\u0917\u0924
      \u0939\u0948!"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016641
    m_Localized: "\u0921\u094D\u0930\u093F\u0932\u0930 \u0905\u092F\u0938\u094D\u0915\u094B\u0902
      \u0915\u093E \u0916\u0928\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902
      \u0914\u0930 \u0938\u093E\u092E\u0917\u094D\u0930\u0940 \u0917\u093F\u0930\u093E\u0924\u0947
      \u0939\u0948\u0902\u0964 \u0939\u0947\u0932\u0930 \u0938\u093E\u092E\u0917\u094D\u0930\u0940
      \u0909\u0920\u093E\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928\u094D\u0939\u0947\u0902
      \u0930\u093F\u092B\u093E\u0907\u0928\u0930\u0940 \u092E\u0947\u0902 \u0932\u093E\u0924\u0947
      \u0939\u0948\u0902\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016642
    m_Localized: "\u092F\u0947 \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928 \u092C\u0942\u0938\u094D\u091F
      \u092C\u091F\u0928 \u0939\u0948\u0902\u0964 \u0906\u092A 2 \u0917\u0941\u0928\u093E
      \u0932\u093E\u092D, 50% \u0917\u0924\u093F \u0935\u0943\u0926\u094D\u0927\u093F
      \u0914\u0930 3 \u0917\u0941\u0928\u093E \u0935\u093F\u091C\u0928 \u092A\u094D\u0930\u093E\u092A\u094D\u0924
      \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016643
    m_Localized: "\u0917\u0948\u0930\u093E\u091C \u0906\u092A\u0915\u094B \u0928\u090F
      \u0935\u093E\u0939\u0928 \u0916\u0930\u0940\u0926\u0928\u0947 \u0914\u0930
      \u0924\u0948\u0928\u093E\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0941\u0935\u093F\u0927\u093E
