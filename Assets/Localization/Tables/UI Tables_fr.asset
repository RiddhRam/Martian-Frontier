  - m_Id: 27354519822336
    m_Localized: APPUYEZ POUR CONTINUER
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016640
    m_Localized: "BIENVENUE \xC0 LA FRONTI\xC8RE MARTIENNE\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016641
    m_Localized: "LES FOREURS EXTRAIENT DES MINERAIS ET LAISSENT TOMBER DES MATERIAUX.
      LES TRANSPORTEURS R\xC9CUP\xC9RENT LES MAT\xC9RIAUX ET LES APPORTENT \xC0 LA
      RAFFINERIE."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016642
    m_Localized: "CE SONT LES BOUTONS AD BOOST. VOUS POUVEZ OBTENIR DES PROFITS 2X,
      UNE AUGMENTATION DE LA VITESSE DE 50\_% ET UNE VISION 3X."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016643
    m_Localized: "LE GARAGE VOUS PERMET D'ACHETER ET DE D\xC9PLOYER DE NOUVEAUX V\xC9HICULES."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016644
    m_Localized: "DANS LE PANNEAU DE MINERAI, VOUS POUVEZ VOIR LE PRIX DE CHAQUE
      MAT\xC9RIAU ET VOS PROFITS AUGMENT\xC9S."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016645
    m_Localized: C'EST LA BASE EN EFFET ! MAINTENANT, LAISSEZ-VOUS EMBRASSER L'AVENTURE
      MINIERES !
    m_Metadata:
      m_Items: []
