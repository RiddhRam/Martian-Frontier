    m_Metadata:
      m_Items: []
  - m_Id: 27354519822336
    m_Localized: "\u041D\u0410\u0416\u041C\u0418\u0422\u0415, \u0427\u0422\u041E\u0411\u042B
      \u041F\u0420\u041E\u0414\u041E\u041B\u0416\u0418\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016640
    m_Localized: "\u0414\u041E\u0411\u0420\u041E \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C
      \u041D\u0410 \u041C\u0410\u0420\u0421\u0418\u0410\u041D\u0421\u041A\u0418\u0419
      \u0413\u0420\u0410\u041D\u0418\u0426\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016641
    m_Localized: "\u0411\u0423\u0420\u0418\u041B\u042C\u041D\u0418\u041A\u0418 \u0414\u041E\u0411\u042B\u0412\u0410\u042E\u0422
      \u0420\u0423\u0414\u042B \u0418 \u041C\u0410\u0422\u0415\u0420\u0418\u0410\u041B\u042B.
      \u0410\u0412\u0422\u041E\u0411\u0423\u0421\u042B \u041F\u041E\u0414\u0411\u0418\u0420\u0410\u042E\u0422
      \u041C\u0410\u0422\u0415\u0420\u0418\u0410\u041B\u042B \u0418 \u041F\u0420\u0418\u0412\u0415\u0417\u042F\u042E\u0422
      \u041D\u0410 \u041D\u041F\u0417."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016642
    m_Localized: "\u042D\u0422\u041E \u041A\u041D\u041E\u041F\u041A\u0418 \u0423\u0421\u0418\u041B\u0415\u041D\u0418\u042F
      \u0420\u0415\u041A\u041B\u0410\u041C\u042B. \u0412\u042B \u041C\u041E\u0416\u0415\u0422\u0415
      \u041F\u041E\u041B\u0423\u0427\u0418\u0422\u042C 2\u0425 \u041F\u0420\u0418\u0411\u042B\u041B\u042C,
      \u0423\u0412\u0415\u041B\u0418\u0427\u0415\u041D\u0418\u0415 \u0421\u041A\u041E\u0420\u041E\u0421\u0422\u0418
      \u041D\u0410 50% \u0418 \u0412\u0418\u0414\u0415\u041D\u0418\u0415 \u0412 3\u0425."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016643
    m_Localized: "\u0413\u0410\u0420\u0410\u0416 \u041F\u041E\u0417\u0412\u041E\u041B\u042F\u0415\u0422
      \u0412\u0410\u041C \u041F\u041E\u041A\u0423\u041F\u0410\u0422\u042C \u0418
      \u0423\u0421\u0422\u0410\u041D\u0410\u0412\u041B\u0418\u0412\u0410\u0422\u042C
      \u041D\u041E\u0412\u042B\u0415 \u0422\u0420\u0410\u041D\u0421\u041F\u041E\u0420\u0422\u041D\u042B\u0415
      \u0421\u0420\u0415\u0414\u0421\u0422\u0412\u0410."
    m_Metadata:
      m_Items: []
  - m_Id: 27354524016644
    m_Localized: "\u041D\u0410 \u041F\u0410\u041D\u0415\u041B\u0418 \xAB\u0420\u0423\u0414\u0410\xBB
      \u0412\u042B \u041C\u041E\u0416\u0415\u0422\u0415 \u0423\u0412\u0418\u0414\u0415\u0422\u042C
      \u0426\u0415\u041D\u0423 \u041A\u0410\u0416\u0414\u041E\u0413\u041E \u041C\u0410\u0422\u0415\u0420\u0418\u0410\u041B\u0410
      \u0418 \u0423\u0412\u0415\u041B\u0418\u0427\u0415\u041D\u0418\u0415 \u0412\u0410\u0428\u0415\u0419
